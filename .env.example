# ==============================================================================
# Doc-to-Podcast — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your API keys.
# All keys below marked REQUIRED must be set before running the app.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM API Keys (REQUIRED — both are free tier)
# ------------------------------------------------------------------------------

# Google Gemini API key (FREE — get at https://ai.google.dev)
GEMINI_API_KEY=

# Groq API key (FREE — get at https://console.groq.com)
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# LLM Configuration (optional)
# ------------------------------------------------------------------------------

# Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Groq model name (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Maximum LLM retries before failing (default: 3)
LLM_MAX_RETRIES=3

# LLM request timeout in seconds (default: 120)
LLM_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# TTS Voice Configuration (optional)
# ------------------------------------------------------------------------------

# Male host (Alex) voice — must be a valid Edge TTS voice ID
MALE_VOICE=en-US-AndrewMultilingualNeural

# Female host (Maya) voice — must be a valid Edge TTS voice ID
FEMALE_VOICE=en-US-AvaMultilingualNeural

# Fallback voices if primary voices are unavailable
MALE_VOICE_FALLBACK=en-US-AndrewNeural
FEMALE_VOICE_FALLBACK=en-US-EmmaMultilingualNeural

# TTS batch size for parallel processing (default: 10)
TTS_BATCH_SIZE=10

# Max concurrent Edge TTS connections (default: 5)
TTS_MAX_CONCURRENT=5

# ------------------------------------------------------------------------------
# Audio Processing Configuration (optional)
# ------------------------------------------------------------------------------

# Pause between different speakers in milliseconds (default: 350)
SPEAKER_PAUSE_MS=350

# Pause for same speaker continuation in milliseconds (default: 150)
CONTINUATION_PAUSE_MS=150

# Crossfade duration in milliseconds (default: 50)
CROSSFADE_MS=50

# Target loudness in dBFS — broadcast standard (default: -16.0)
TARGET_DBFS=-16.0

# Output MP3 bitrate (default: 192k)
OUTPUT_BITRATE=192k

# Output sample rate in Hz (default: 44100)
SAMPLE_RATE=44100

# ------------------------------------------------------------------------------
# File Storage Paths (optional — defaults are relative to project root)
# ------------------------------------------------------------------------------

# Directory for uploaded documents
UPLOAD_DIR=uploads

# Directory for generated podcast audio files
OUTPUT_DIR=output

# Directory for temporary audio clips during processing
TEMP_DIR=temp

# ------------------------------------------------------------------------------
# Application Configuration (optional)
# ------------------------------------------------------------------------------

# Host to bind the server to (default: 0.0.0.0)
APP_HOST=0.0.0.0

# Port to bind the server to (default: 8000)
APP_PORT=8000

# Enable debug mode (default: false)
APP_DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Maximum upload file size in bytes (default: 104857600 = 100MB)
MAX_UPLOAD_SIZE=104857600

# Maximum podcast length in minutes (default: 120)
MAX_PODCAST_LENGTH_MINUTES=120
